{
  "name": "oceanview",
  "displayName": "OceanView",
  "description": "浏览 Protobuf，并用 gRPC / HTTP / SSE / WebSocket 调试接口：侧边栏导航、Client、Auth、压测与链路调试",
  "version": "0.1.1",
  "private": true,
  "publisher": "zoceanfly",
  "license": "MIT",
  "homepage": "https://github.com/zhhOceanfly/OceanView",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhhOceanfly/OceanView.git"
  },
  "bugs": {
    "url": "https://github.com/zhhOceanfly/OceanView/issues"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "keywords": [
    "protobuf",
    "proto",
    "grpc",
    "oceanview",
    "grpcurl",
    "api"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Testing",
    "Other"
  ],
  "activationEvents": [
    "onView:oceanview.explorer",
    "onCommand:oceanview.show",
    "onCommand:oceanview.openClient",
    "workspaceContains:**/*.proto"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "oceanview.excelDiff",
        "title": "ExcelView 差异对比",
        "icon": "$(diff)",
        "category": "OceanView"
      },
      {
        "command": "oceanview.excelDiffUris",
        "title": "ExcelView 差异对比（两版本）",
        "category": "OceanView"
      },
      {
        "command": "oceanview.openExcelView",
        "title": "在 ExcelView 中打开",
        "category": "OceanView"
      },
      {
        "command": "oceanview.openDocsView",
        "title": "在 DocsView 中打开",
        "category": "OceanView"
      },
      {
        "command": "oceanview.openDbView",
        "title": "在 DbView 中打开",
        "category": "OceanView"
      },
      {
        "command": "oceanview.openProtoView",
        "title": "在 ProtoView 中打开",
        "category": "OceanView"
      },
      {
        "command": "oceanview.show",
        "title": "在预览中打开",
        "category": "OceanView"
      },
      {
        "command": "oceanview.openSource",
        "title": "跳转到源码",
        "icon": "$(go-to-file)",
        "category": "OceanView"
      },
      {
        "command": "oceanview.refresh",
        "title": "重新解析",
        "icon": "$(refresh)",
        "category": "OceanView"
      },
      {
        "command": "oceanview.showAtCursor",
        "title": "预览光标所在定义",
        "category": "OceanView"
      },
      {
        "command": "oceanview.toggleSourceMode",
        "title": "切换 Proto 来源",
        "category": "OceanView"
      },
      {
        "command": "oceanview.editGitUrl",
        "title": "编辑 Git 地址",
        "category": "OceanView"
      },
      {
        "command": "oceanview.editGitBranch",
        "title": "编辑 Git 分支",
        "category": "OceanView"
      },
      {
        "command": "oceanview.syncGitSource",
        "title": "同步 Git Proto 来源",
        "icon": "$(cloud-download)",
        "category": "OceanView"
      },
      {
        "command": "oceanview.showGitLog",
        "title": "查看 Git 拉取日志",
        "category": "OceanView"
      },
      {
        "command": "oceanview.openGitTemp",
        "title": "打开 Git 临时目录",
        "category": "OceanView"
      },
      {
        "command": "oceanview.openClient",
        "title": "打开 ProtoView Client",
        "icon": "$(window)",
        "category": "OceanView"
      },
      {
        "command": "oceanview.formatDocument",
        "title": "格式化 Proto",
        "category": "OceanView"
      }
    ],
    "languages": [
      {
        "id": "protobuf",
        "aliases": [
          "Protocol Buffers",
          "protobuf",
          "proto"
        ],
        "extensions": [
          ".proto"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "oceanview",
          "title": "OceanView",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "oceanview": [
        {
          "id": "oceanview.explorer",
          "name": "ProtoView"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "oceanview.refresh",
          "when": "view == oceanview.explorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "oceanview.openSource",
          "when": "view == oceanview.explorer && viewItem == source",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "oceanview.showAtCursor",
          "when": "resourceExtname == .proto",
          "group": "navigation"
        },
        {
          "command": "oceanview.formatDocument",
          "when": "resourceExtname == .proto",
          "group": "1_modification"
        },
        {
          "command": "oceanview.excelDiff",
          "when": "resourceExtname == .xlsx || resourceExtname == .xlsm || resourceExtname == .xls || resourceExtname == .csv",
          "group": "navigation"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "oceanview.excelDiff",
          "when": "resourceExtname == .xlsx || resourceExtname == .xlsm || resourceExtname == .xls || resourceExtname == .csv",
          "group": "1_modification"
        }
      ],
      "scm/resourceFolder/context": [
        {
          "command": "oceanview.excelDiff",
          "when": "resourceExtname == .xlsx || resourceExtname == .xlsm",
          "group": "1_modification"
        }
      ],
      "editor/title": [
        {
          "command": "oceanview.openProtoView",
          "when": "resourceExtname == .proto",
          "group": "navigation@9"
        },
        {
          "command": "oceanview.openDbView",
          "when": "resourceExtname == .sql",
          "group": "navigation@9"
        },
        {
          "command": "oceanview.openDocsView",
          "when": "resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdx || resourceExtname == .docx",
          "group": "navigation@9"
        },
        {
          "command": "oceanview.openExcelView",
          "when": "resourceExtname == .xlsx || resourceExtname == .xlsm || resourceExtname == .xls || resourceExtname == .csv",
          "group": "navigation@9"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "oceanview.excelViewer",
        "displayName": "ExcelView",
        "selector": [
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.xlsm"
          },
          {
            "filenamePattern": "*.xls"
          },
          {
            "filenamePattern": "*.csv"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "oceanview.docsViewer",
        "displayName": "DocsView",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          },
          {
            "filenamePattern": "*.mdx"
          },
          {
            "filenamePattern": "*.docx"
          }
        ],
        "priority": "default"
      }
    ],
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "*.md": "oceanview.docsViewer",
        "*.markdown": "oceanview.docsViewer",
        "*.mdx": "oceanview.docsViewer",
        "*.docx": "oceanview.docsViewer",
        "*.xlsx": "oceanview.excelViewer",
        "*.xlsm": "oceanview.excelViewer"
      },
      "[protobuf]": {
        "editor.defaultFormatter": "zoceanfly.oceanview",
        "editor.formatOnSave": false,
        "editor.wordBasedSuggestions": "off"
      }
    },
    "configuration": {
      "title": "OceanView",
      "properties": {
        "oceanview.showGoogle": {
          "type": "boolean",
          "default": false,
          "description": "在侧边栏中显示 google.* 标准包。关闭时仍会解析它们，以便跳转到被引用的类型。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "clean:vsix": "node -e \"const fs=require('fs');for(const f of fs.readdirSync('.'))if(f.endsWith('.vsix'))fs.unlinkSync(f)\"",
    "package:precheck": "vsce ls --tree",
    "package": "npm run compile && vsce package",
    "package:fresh": "npm run clean:vsix && npm run package",
    "publish": "npm run compile && vsce publish",
    "publish:patch": "npm run compile && vsce publish patch",
    "publish:minor": "npm run compile && vsce publish minor",
    "openvsx:namespace": "node scripts/openvsx-publish.js namespace",
    "publish:openvsx": "npm run package && node scripts/openvsx-publish.js publish",
    "build:cli": "node scripts/build-cli.js",
    "dev:cli": "node scripts/dev-cli.js",
    "publish:cli": "npm run build:cli && npm publish ./packages/cli --access public --registry https://registry.npmjs.org/",
    "build:dbx": "node scripts/build-dbx-plugin.js",
    "package:dbx": "npm run build:dbx && npm run package --prefix packages/dbx-plugin",
    "dev:dbx": "npm run build:dbx && npm run dev --prefix packages/dbx-plugin",
    "store:lf:dbx": "npm run store:lf --prefix packages/dbx-plugin"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^2.32.0",
    "ovsx": "^0.10.1",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "mysql2": "^3.24.6",
    "nrm": "^2.1.0",
    "protobufjs": "^7.5.4",
    "xlsx": "^0.18.5"
  }
}
